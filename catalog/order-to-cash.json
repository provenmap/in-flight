{
  "flow": "order-to-cash",
  "revision": 2,
  "currency": "USD",
  "roles": {"case": "Order", "party": "Customer", "measure": "Order.total"},
  "districts": [
    {"id": "orders", "name": "Orders"},
    {"id": "payments", "name": "Payments"},
    {"id": "inventory", "name": "Inventory"},
    {"id": "shipping", "name": "Shipping"},
    {"id": "customers", "name": "Customers", "sink": true}
  ],
  "entities": {
    "Order": {"total": "decimal", "status": "string", "payment": "string", "stock": "string"},
    "Customer": {}
  },
  "events": [
    {
      "type": "OrderPlaced", "version": 1, "topic": "orders.placed", "district": "orders",
      "value": "total", "customer": "customerId", "order": "orderId",
      "fields": {"orderId": "string", "customerId": "string", "total": "decimal", "currency": "string", "placedAt": "timestamp"},
      "keys": {"Order": "orderId", "Customer": "customerId"},
      "effects": [
        {"op": "assign", "attribute": "Order.total", "from": "total"},
        {"op": "assign", "attribute": "Order.status", "value": "placed"}
      ]
    },
    {
      "type": "OrderPlaced", "version": 2, "topic": "orders.placed", "district": "orders",
      "value": "total.amount", "customer": "customerId", "order": "orderId",
      "fields": {"orderId": "string", "customerId": "string", "total": {"amount": "decimal", "currency": "string"}, "placedAt": "timestamp"},
      "keys": {"Order": "orderId", "Customer": "customerId"},
      "effects": [
        {"op": "assign", "attribute": "Order.total", "from": "total.amount"},
        {"op": "assign", "attribute": "Order.status", "value": "placed"}
      ]
    },
    {
      "type": "PaymentAuthorized", "version": 1, "topic": "payments.authorized", "district": "payments",
      "value": "amount", "customer": "customerId", "order": "orderId",
      "fields": {"orderId": "string", "customerId": "string", "amount": "decimal", "currency": "string"},
      "keys": {"Order": "orderId", "Customer": "customerId"},
      "effects": [
        {"op": "assign", "attribute": "Order.payment", "value": "authorized"}
      ]
    },
    {
      "type": "PaymentDeclined", "version": 1, "topic": "payments.declined", "district": "payments",
      "value": "amount", "customer": "customerId", "order": "orderId",
      "fields": {"orderId": "string", "customerId": "string", "amount": "decimal", "currency": "string"},
      "keys": {"Order": "orderId", "Customer": "customerId"},
      "effects": [
        {"op": "assign", "attribute": "Order.payment", "value": "declined"}
      ]
    },
    {
      "type": "StockReserved", "version": 1, "topic": "inventory.reserved", "district": "inventory",
      "value": "value", "customer": "customerId", "order": "orderId",
      "fields": {"orderId": "string", "customerId": "string", "value": "decimal"},
      "keys": {"Order": "orderId", "Customer": "customerId"},
      "effects": [
        {"op": "assign", "attribute": "Order.stock", "value": "reserved"}
      ]
    },
    {
      "type": "OrderDispatched", "version": 1, "topic": "shipping.dispatched", "district": "shipping",
      "value": "orderTotal", "customer": "customerId", "order": "orderId",
      "fields": {"orderId": "string", "customerId": "string", "orderTotal": "decimal", "carrier": "string", "dispatchedAt": "timestamp"},
      "keys": {"Order": "orderId", "Customer": "customerId"},
      "effects": [
        {"op": "assign", "attribute": "Order.status", "value": "dispatched"}
      ]
    }
  ],
  "intents": [
    {"name": "order-total-changes", "predicate": "changes(Order.total)"},
    {"name": "orders-placed", "predicate": "emits(OrderPlaced)", "by": "Order"},
    {"name": "ready-to-ship", "predicate": "emits(PaymentAuthorized) or emits(StockReserved)", "by": "Order"},
    {"name": "order-dispatched", "predicate": "emits(OrderDispatched)", "by": "Order"}
  ],
  "consumers": [
    {"group": "payments-service", "district": "payments", "reads": ["orders.placed"], "dlq": "payments.dlq", "redrive": "payments-service-redrive", "intent": "order-total-changes"},
    {"group": "inventory-service", "district": "inventory", "reads": ["orders.placed"], "dlq": "inventory.dlq", "intent": "orders-placed"},
    {"group": "shipping-service", "district": "shipping", "reads": ["payments.authorized", "inventory.reserved"], "dlq": "shipping.dlq", "intent": "ready-to-ship"},
    {"district": "customers", "reads": ["shipping.dispatched"], "intent": "order-dispatched"}
  ]
}
