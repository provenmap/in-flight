{
  "name": "revenue-in-flight",
  "version": "0.1.0",
  "description": "An event pipeline you see in money: order-to-cash live from Kafka, a schema change that jams Payments, and the redrive that drains it.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "revenue-in-flight": "dist/cli.js"
  },
  "files": [
    "dist",
    "catalog",
    "docker-compose.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:browser": "playwright test",
    "docs:screenshots": "npm run build && playwright test -c playwright.docs.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "simulate": "tsx src/cli.ts simulate",
    "serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "big.js": "^7.0.1",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@types/big.js": "^7.0.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "keywords": [
    "kafka",
    "event-driven",
    "dead-letter-queue",
    "mcp",
    "observability",
    "demo"
  ]
}
