<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.provenmap.inflight</groupId>
    <artifactId>in-flight</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>proxy-filter</artifactId>
  <description>Kroxylicious filters: the intent.&lt;name&gt; alias and the schema gate. Plain Java, loaded by the proxy.</description>

  <properties>
    <!--
      These classes run inside Kroxylicious, not in this build's JVM: the quay.io/kroxylicious/proxy image runs Java 21,
      which cannot load Java 25 class files (the proxy exits at startup, and every client reading through it sees nothing).
      Raise this only with the proxy's own Java.
    -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.kroxylicious</groupId>
      <artifactId>kroxylicious-api</artifactId>
      <version>${kroxylicious.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.kroxylicious</groupId>
      <artifactId>kroxylicious-filter-test-support</artifactId>
      <version>${kroxylicious.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
